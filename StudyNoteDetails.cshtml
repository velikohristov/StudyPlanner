@model StudyPlanner.Models.StudyNote

@{
    ViewData["Title"] = "Study Note Details";
}

<h2>Study Note Details</h2>

<div class="card">
    <div class="card-body">
        <h4>@Model.Title</h4>
        <p><strong>Course:</strong> @Model.Course?.Title</p>
        <p><strong>Created:</strong> @Model.CreatedAt.ToShortDateString()</p>
        <p><strong>Content:</strong></p>
        <div>@Model.Content</div>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning mt-3">Edit</a>
<a asp-action="Index" class="btn btn-secondary mt-3">Back to List</a>